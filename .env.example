# Copy to .env and fill in local values. Never commit .env.
PORT=3000
BASE_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=vishwa
DB_PASSWORD=
DB_NAME=url_shortener
# Keep false; use migrations for schema changes.
TYPEORM_SYNC=false
# Set to true for hosted Postgres that requires TLS (e.g. Neon).
DB_SSL=false
# Optional: comma-separated frontend origin(s) allowed by CORS in production.
# Local Vite dev origins (http://localhost:5173) are always allowed.
FRONTEND_URL=
# Redis cache for short-code lookups (Phase 3). PostgreSQL stays the source
# of truth; when Redis is unreachable the app fails open to PostgreSQL.
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600
